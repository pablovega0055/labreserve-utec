# Variables usadas por docker-compose.yml y por Spring Boot (application.properties las importa)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=examen_db
DB_USER=postgres
DB_PASSWORD=postgres
SERVER_PORT=8080

# JWT (genera uno con: openssl rand -base64 32)
JWT_SECRET=bGFicmVzZXJ2ZS11dGVjLXNlY3JldC1rZXktY3MyMDMxLWRicC0yMDI2
# Duracion del token en milisegundos (1 hora)
JWT_EXPIRATION=3600000
